{
    "name": "blog-project",
    "version": "1.0.0",
    "main": "dist/src/index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "cross-env node dist/index.js",
        "lint": "eslint 'src/**/*.{ts,js}' --fix",
        "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
        "type-check": "tsc --noEmit",
        "verify": "npm run lint && npm run type-check",
        "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
        "migrate:test": "dotenv -e .env.test -- npx prisma migrate dev",
        "migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy",
        "generate": "npx prisma generate",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@prisma/client": "^6.18.0",
        "bcrypt": "^6.0.0",
        "cloudinary": "^1.41.3",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.2",
        "marked": "^17.0.1",
        "multer": "^2.0.2",
        "multer-storage-cloudinary": "^4.0.0",
        "pg": "^8.16.3",
        "quill-delta-to-html": "^0.12.1",
        "sanitize-html": "^2.17.0",
        "slugify": "^1.6.6",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0",
        "zod": "^4.1.9"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@tsconfig/node20": "^20.1.6",
        "@types/bcrypt": "^6.0.0",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/marked": "^5.0.2",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.4.0",
        "@types/sanitize-html": "^2.16.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/yamljs": "^0.2.34",
        "cross-env": "^10.0.0",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.35.0",
        "eslint-plugin-perfectionist": "^4.15.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "prisma": "^6.18.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.43.0"
    }
}
